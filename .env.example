# Copy to .env and fill in.

PORT=4000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sofi_beso
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

# Optional pool tuning (defaults shown)
# DB_POOL_MAX=10
# DB_CONNECT_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=15000

# Comma-separated origins allowed to call the API (cashier, history, admin)
ALLOWED_ORIGINS=http://localhost:3000
# Origin allowed for live updates (Socket.io). Empty allows any.
FRONTEND_URL=http://localhost:3000

# Branch used when a request has no X-Branch-Slug header (older tablets)
DEFAULT_BRANCH_SLUG=main

# Time zone of the business day ("today", daily reports)
BUSINESS_TZ=Africa/Addis_Ababa

# User id recorded as the creator of admin-side records
ADMIN_USER_ID=

# Offline mode: a local server pushes its orders to the cloud every 30s
ENABLE_SYNC=false
CLOUD_API_BASE=https://os.sofi-beso.et

# Only for `npm test`: a separate database whose name contains "test".
# The tests wipe it.
# TEST_DATABASE_URL=postgres://postgres@localhost:5432/sofi_beso_test
